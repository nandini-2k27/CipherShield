##Toolkit.js
import React, { useEffect, useMemo, useState } from "react";
import axios from "axios";

const algorithms = [
  { id: "sha256", label: "SHA-256" },
  { id: "sha512", label: "SHA-512" },
  { id: "blake2b", label: "BLAKE2b" },
];

function Toolkit({ apiBase, onEvent }) {
  const [text, setText] = useState("payment_id=PX-4912&amount=7500");
  const [secret, setSecret] = useState("project-secret-key");
  const [algorithm, setAlgorithm] = useState("sha256");
  const [digest, setDigest] = useState("");
  const [signature, setSignature] = useState("");
  const [verifyInput, setVerifyInput] = useState("");
  const [valid, setValid] = useState(null);
  const [error, setError] = useState("");

  const shortDigest = useMemo(
    () => (digest ? `${digest.slice(0, 18)}...${digest.slice(-12)}` : "Pending"),
    [digest]
  );

  useEffect(() => {
    if (!text.trim()) {
      setDigest("");
      setSignature("");
      setValid(null);
      return;
    }

    const timer = setTimeout(async () => {
      try {
        const [hashResponse, hmacResponse] = await Promise.all([
          axios.post(`${apiBase}/toolkit/hash`, { text, algorithm }),
          axios.post(`${apiBase}/toolkit/hmac`, { text, secret, algorithm }),
        ]);
        setDigest(hashResponse.data.digest);
        setSignature(hmacResponse.data.signature);
        setVerifyInput((current) => current || hmacResponse.data.signature);
        setError("");
        onEvent("Toolkit", `${algorithm.toUpperCase()} digest and HMAC generated.`);
      } catch (err) {
        setError(err.response?.data?.error || "Toolkit service unavailable.");
      }
    }, 350);

    return () => clearTimeout(timer);
  }, [algorithm, apiBase, onEvent, secret, text]);

  const verify = async () => {
    try {
      const response = await axios.post(`${apiBase}/toolkit/hmac/verify`, {
        text,
        secret,
        signature: verifyInput,
        algorithm,
      });
      setValid(response.data.valid);
      onEvent("Verify", response.data.valid ? "HMAC signature verified." : "HMAC verification failed.");
    } catch (err) {
      setError(err.response?.data?.error || "Verification failed.");
    }
  };

  return (
    <section className="tool-grid">
      <div className="panel control-panel">
        <p className="eyebrow">Integrity engineering</p>
        <h3>Hash and HMAC Toolkit</h3>

        <div className="mode-switch">
          {algorithms.map((item) => (
            <button
              className={algorithm === item.id ? "mode active" : "mode"}
              key={item.id}
              onClick={() => setAlgorithm(item.id)}
            >
              <strong>{item.label}</strong>
              <span>Digest algorithm</span>
            </button>
          ))}
        </div>

        <label className="field">
          <span>Message or payload</span>
          <textarea
            value={text}
            onChange={(event) => setText(event.target.value)}
            rows="7"
          />
        </label>

        <label className="field">
          <span>Shared secret</span>
          <input
            value={secret}
            onChange={(event) => setSecret(event.target.value)}
          />
        </label>

        <label className="field">
          <span>Signature to verify</span>
          <input
            value={verifyInput}
            onChange={(event) => setVerifyInput(event.target.value)}
          />
        </label>

        <div className="action-row">
          <button className="primary-btn" onClick={verify} disabled={!verifyInput}>
            Verify HMAC
          </button>
        </div>
        {error && <p className="error-text">{error}</p>}
      </div>

      <div className="panel output-panel">
        <div className="output-header">
          <div>
            <p className="eyebrow">Tamper detection</p>
            <h3>{valid === null ? "Live digest" : valid ? "Valid signature" : "Tampered payload"}</h3>
          </div>
          <span>{algorithm.toUpperCase()}</span>
        </div>

        <div className={valid === false ? "integrity-card invalid" : "integrity-card"}>
          <span>Integrity state</span>
          <strong>{valid === null ? "Ready" : valid ? "Verified" : "Rejected"}</strong>
          <p>{shortDigest}</p>
        </div>

        <div className="terminal-box">
          <span className="terminal-label">hash digest</span>
          <pre>{digest || "Hash output will appear here."}</pre>
        </div>

        <div className="terminal-box success">
          <span className="terminal-label">hmac signature</span>
          <pre>{signature || "HMAC signature will appear here."}</pre>
        </div>
      </div>
    </section>
  );
}

export default Toolkit;


