##ANALYZER.JS
import React, { useEffect, useMemo, useState } from "react";
import axios from "axios";

function Analyzer({ apiBase, onEvent }) {
  const [text, setText] = useState("S3cur3-Payload::alpha-4921");
  const [result, setResult] = useState(null);
  const [error, setError] = useState("");

  const uniqueChars = useMemo(() => new Set(text).size, [text]);
  const score = Math.min(100, Math.round(((result?.entropy || 0) / 6) * 100));

  useEffect(() => {
    if (!text.trim()) {
      setResult(null);
      return;
    }

    const timer = setTimeout(async () => {
      try {
        const response = await axios.post(`${apiBase}/analyze`, { text });
        setResult(response.data);
        setError("");
        onEvent("Analyze", `Entropy scored at ${response.data.entropy}.`);
      } catch (err) {
        setError(err.response?.data?.error || "Analyzer service unavailable.");
      }
    }, 450);

    return () => clearTimeout(timer);
  }, [apiBase, onEvent, text]);

  return (
    <section className="tool-grid">
      <div className="panel control-panel">
        <p className="eyebrow">Live strength scoring</p>
        <h3>Entropy Analyzer</h3>
        <label className="field">
          <span>Message sample</span>
          <textarea
            value={text}
            onChange={(event) => setText(event.target.value)}
            rows="10"
          />
        </label>
        {error && <p className="error-text">{error}</p>}
      </div>

      <div className="panel analyzer-panel">
        <p className="eyebrow">Risk telemetry</p>
        <div className="score-ring" style={{ "--score": `${score}%` }}>
          <strong>{score}</strong>
          <span>score</span>
        </div>
        <h3>{result?.level || "Waiting for input"}</h3>
        <p>{result?.recommendation || "Type a sample to start real-time analysis."}</p>

        <div className="telemetry-grid">
          <div>
            <span>Entropy</span>
            <strong>{result?.entropy ?? "0.000"}</strong>
          </div>
          <div>
            <span>Length</span>
            <strong>{text.length}</strong>
          </div>
          <div>
            <span>Unique chars</span>
            <strong>{uniqueChars}</strong>
          </div>
        </div>

        <div className="meter">
          <span style={{ width: `${score}%` }} />
        </div>
      </div>
    </section>
  );
}

export default Analyzer;






##Attack.JS
import React, { useEffect, useState } from "react";
import axios from "axios";

function Attack({ apiBase, onEvent }) {
  const [text, setText] = useState("Dwwdfn dw gdzq");
  const [results, setResults] = useState([]);
  const [frequency, setFrequency] = useState([]);
  const [error, setError] = useState("");

  useEffect(() => {
    if (!text.trim()) {
      setResults([]);
      setFrequency([]);
      return;
    }

    const timer = setTimeout(async () => {
      try {
        const response = await axios.post(`${apiBase}/attack`, { text });
        setResults(response.data.results || []);
        setFrequency(response.data.frequency || []);
        setError("");
        onEvent("Attack", "Caesar brute-force simulation completed.");
      } catch (err) {
        setError(err.response?.data?.error || "Attack service unavailable.");
