#CHAT.JS
import React, { useMemo, useState } from "react";
import axios from "axios";

const modes = [
  { id: "aes", label: "AES", helper: "Fast symmetric encryption" },
  { id: "rsa", label: "RSA", helper: "Public-key encryption" },
  { id: "caesar", label: "Caesar", helper: "Classical shift cipher" },
  { id: "vigenere", label: "Vigenere", helper: "Polyalphabetic cipher" },
];

function Chat({ apiBase, onEvent }) {
  const [mode, setMode] = useState("aes");
  const [text, setText] = useState("Meet at 21:30 near node alpha.");
  const [key, setKey] = useState("");
  const [caesarKey, setCaesarKey] = useState(3);
  const [vigenereKey, setVigenereKey] = useState("cipher");
  const [cipher, setCipher] = useState("");
  const [plain, setPlain] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const payloadSize = useMemo(() => new Blob([text]).size, [text]);

  const endpoint = (action) => `${apiBase}/${mode}/${action}`;

  const encrypt = async () => {
    setLoading(true);
    setError("");
    setPlain("");
    try {
      const body =
        mode === "caesar"
          ? { text, key: Number(caesarKey) }
          : mode === "vigenere"
          ? { text, key: vigenereKey }
          : { text };
      const response = await axios.post(endpoint("encrypt"), body);
      setCipher(response.data.cipher);
      if (response.data.key) {
        setKey(response.data.key);
      }
      onEvent("Encrypt", `${mode.toUpperCase()} encrypted ${payloadSize} bytes.`);
    } catch (err) {
      setError(err.response?.data?.error || "Encryption failed.");
    } finally {
      setLoading(false);
    }
  };

  const decrypt = async () => {
    setLoading(true);
    setError("");
    try {
      const body =
        mode === "aes"
          ? { cipher, key }
          : mode === "caesar"
          ? { text: cipher, key: Number(caesarKey) }
          : mode === "vigenere"
          ? { text: cipher, key: vigenereKey }
          : { cipher };
      const response = await axios.post(endpoint("decrypt"), body);
      setPlain(response.data.message);
      onEvent("Decrypt", `${mode.toUpperCase()} payload decrypted successfully.`);
    } catch (err) {
      setError(err.response?.data?.error || "Decryption failed.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <section className="tool-grid">
      <div className="panel control-panel">
        <p className="eyebrow">Encryption workflow</p>
        <h3>Secure Message Lab</h3>

        <div className="mode-switch">
          {modes.map((item) => (
            <button
              className={mode === item.id ? "mode active" : "mode"}
              key={item.id}
              onClick={() => {
                setMode(item.id);
                setCipher("");
                setPlain("");
                setError("");
              }}
            >
              <strong>{item.label}</strong>
              <span>{item.helper}</span>
            </button>
          ))}
        </div>

        <label className="field">
          <span>Plain text</span>
          <textarea
            value={text}
            onChange={(event) => setText(event.target.value)}
            rows="8"
          />
        </label>

        <div className="inline-fields">
          {mode === "caesar" && (
            <label className="field compact">
              <span>Shift key</span>
              <input
                max="25"
                min="0"
                onChange={(event) => setCaesarKey(event.target.value)}
                type="number"
                value={caesarKey}
              />
            </label>
          )}

          {mode === "vigenere" && (
            <label className="field compact grow">
              <span>Keyword</span>
              <input
                onChange={(event) => setVigenereKey(event.target.value)}
                placeholder="Example: cipher"
                value={vigenereKey}
              />
            </label>
          )}

          {mode === "aes" && (
            <label className="field compact grow">
              <span>AES key</span>
              <input
                onChange={(event) => setKey(event.target.value)}
                placeholder="Generated after encryption"
                value={key}
              />
            </label>
          )}
        </div>

        <div className="action-row">
          <button className="primary-btn" disabled={loading || !text} onClick={encrypt}>
            {loading ? "Processing" : "Encrypt"}
          </button>
          <button className="ghost-btn" disabled={loading || !cipher} onClick={decrypt}>
            Decrypt
          </button>
        </div>
        {error && <p className="error-text">{error}</p>}
      </div>

      <div className="panel output-panel">
        <div className="output-header">
          <div>
            <p className="eyebrow">Cipher output</p>
            <h3>{mode.toUpperCase()} result</h3>
          </div>
          <span>{payloadSize} bytes</span>
        </div>

        <div className="terminal-box">
          <span className="terminal-label">ciphertext</span>
          <pre>{cipher || "Run encryption to generate protected output."}</pre>
        </div>

        <div className="terminal-box success">
          <span className="terminal-label">decrypted text</span>
          <pre>{plain || "Decrypt a cipher to verify message integrity."}</pre>
        </div>
      </div>
    </section>
  );
}

export default Chat;


