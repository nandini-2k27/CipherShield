import React, { useCallback, useEffect, useMemo, useState } from "react";
import axios from "axios";
import Dashboard from "./components/Dashboard";
import Chat from "./components/Chat";
import Analyzer from "./components/Analyzer";
import Attack from "./components/Attack";
import Toolkit from "./components/Toolkit";
import "./App.css";

const API_BASE = "http://127.0.0.1:5000";

const navItems = [
  { id: "dashboard", label: "Dashboard", hint: "Live overview" },
  { id: "chat", label: "Crypto Lab", hint: "AES, RSA, Caesar" },
  { id: "toolkit", label: "Toolkit", hint: "Hash and HMAC" },
  { id: "analyze", label: "Analyzer", hint: "Entropy scoring" },
  { id: "attack", label: "Attack Lab", hint: "Brute force" },
];

function App() {
  const [page, setPage] = useState("dashboard");
  const [apiStatus, setApiStatus] = useState("checking");
  const [events, setEvents] = useState([
    { type: "System", detail: "CipherShield console initialized." },
  ]);

  const addEvent = useCallback((type, detail) => {
    setEvents((current) => [{ type, detail }, ...current].slice(0, 8));
  }, []);

  useEffect(() => {
    let active = true;

    const checkHealth = async () => {
      try {
        await axios.get(`${API_BASE}/health`, { timeout: 1800 });
        if (active) {
          setApiStatus("online");
        }
      } catch {
        if (active) {
          setApiStatus("offline");
        }
      }
    };

    checkHealth();
    const timer = setInterval(checkHealth, 5000);
    return () => {
      active = false;
      clearInterval(timer);
    };
  }, []);

  const activeTitle = useMemo(
    () => navItems.find((item) => item.id === page)?.label || "Dashboard",
    [page]
  );

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-mark">CS</div>
          <div>
            <h1>CipherShield</h1>
            <p>CNS security console</p>
          </div>
        </div>

        <nav className="nav-list">
          {navItems.map((item) => (
            <button
              className={page === item.id ? "nav-item active" : "nav-item"}
              key={item.id}
              onClick={() => setPage(item.id)}
            >
              <span>{item.label}</span>
              <small>{item.hint}</small>
            </button>
          ))}
        </nav>

        <div className="status-card">
          <span className={`status-dot ${apiStatus}`} />
          <div>
            <strong>API {apiStatus}</strong>
            <p>Flask service at 127.0.0.1:5000</p>
          </div>
        </div>
      </aside>

      <main className="main">
        <header className="topbar">
          <div>
            <p className="eyebrow">Active workspace</p>
            <h2>{activeTitle}</h2>
          </div>
          <div className="topbar-metrics">
            <div>
              <span>Algorithms</span>
              <strong>7</strong>
            </div>
            <div>
              <span>Signals</span>
              <strong>Live</strong>
            </div>
          </div>
        </header>

        <div className="workspace">
          {page === "dashboard" && (
            <Dashboard apiStatus={apiStatus} events={events} />
          )}
          {page === "chat" && <Chat apiBase={API_BASE} onEvent={addEvent} />}
          {page === "toolkit" && (
            <Toolkit apiBase={API_BASE} onEvent={addEvent} />
          )}
          {page === "analyze" && (
            <Analyzer apiBase={API_BASE} onEvent={addEvent} />
          )}
          {page === "attack" && <Attack apiBase={API_BASE} onEvent={addEvent} />}
        </div>
      </main>
    </div>
  );
}

export default App;



